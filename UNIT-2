//1: Order of Execution of Operators
#include <stdio.stdio.h>

int main() {
    int a = 10, b = 20, c = 5, d = 2;
    int result;

    // Demonstration of operator precedence and associativity
    // (* and / have higher precedence than + and -)
    result = a + b * c / d; 
    // Step-by-step: 20 * 5 = 100 -> 100 / 2 = 50 -> 10 + 50 = 60
    printf("Result of (a + b * c / d): %d\n", result);

    // Parentheses change the default evaluation order
    result = (a + b) * (c / d);
    // Step-by-step: (10 + 20) = 30 -> (5 / 2) = 2 -> 30 * 2 = 60
    printf("Result of ((a + b) * (c / d)): %d\n", result);

    // Relational and logical operators execution order
    result = a + b > c && d < b;
    // Step-by-step: (10 + 20) = 30 -> 30 > 5 (True: 1) -> 2 < 20 (True: 1) -> 1 && 1 = 1
    printf("Result of (a + b > c && d < b): %d\n", result);

    return 0;
}


//2: Check Whether a Number is Even or Odd
#include <stdio.h>

int main() {
    int num;

    printf("Enter an integer: ");
    scanf("%d", &num);

    if (num % 2 == 0) {
        printf("%d is an Even number.\n", num);
    } else {
        printf("%d is an Odd number.\n", num);
    }

    return 0;
}

//3: Determine if a Number is Positive, Negative, or Zero
#include <stdio.h>

int main() {
    int num;

    printf("Enter a number: ");
    scanf("%d", &num);

    if (num > 0) {
        printf("%d is Positive.\n", num);
    } else if (num < 0) {
        printf("%d is Negative.\n", num);
    } else {
        printf("The number is Zero.\n");
    }

    return 0;
}

//4: Menu-Driven Calculator using Switch-Case (Repeats until Exit)
#include <stdio.h>

int main() {
    int choice;
    float num1, num2, result;

    while (1) {
        printf("\n--- MENU-DRIVEN CALCULATOR ---\n");
        printf("1. Addition (+)\n");
        printf("2. Subtraction (-)\n");
        printf("3. Multiplication (*)\n");
        printf("4. Division (/)\n");
        printf("5. Exit\n");
        printf("Enter your choice (1-5): ");
        scanf("%d", &choice);

        if (choice == 5) {
            printf("Exiting program. Goodbye!\n");
            break;
        }

        if (choice >= 1 && choice <= 4) {
            printf("Enter two numbers: ");
            scanf("%f %f", &num1, &num2);
        }

        switch (choice) {
            case 1:
                result = num1 + num2;
                printf("Result: %.2f + %.2f = %.2f\n", num1, num2, result);
                break;
            case 2:
                result = num1 - num2;
                printf("Result: %.2f - %.2f = %.2f\n", num1, num2, result);
                break;
            case 3:
                result = num1 * num2;
                printf("Result: %.2f * %.2f = %.2f\n", num1, num2, result);
                break;
            case 4:
                if (num2 != 0) {
                    result = num1 / num2;
                    printf("Result: %.2f / %.2f = %.2f\n", num1, num2, result);
                } else {
                    printf("Error: Division by zero is not allowed.\n");
                }
                break;
            default:
                printf("Invalid choice! Please choose a valid option (1-5).\n");
        }
    }

    return 0;
}

//5: Multiplication Table using while, do-while, and for Loops
#include <stdio.h>

int main() {
    int num, i;

    printf("Enter a number to generate its multiplication table: ");
    scanf("%d", &num);

    // 1. Using 'for' loop
    printf("\n--- Multiplication Table using FOR Loop ---\n");
    for (i = 1; i <= 10; i++) {
        printf("%d x %d = %d\n", num, i, num * i);
    }

    // 2. Using 'while' loop
    printf("\n--- Multiplication Table using WHILE Loop ---\n");
    i = 1;
    while (i <= 10) {
        printf("%d x %d = %d\n", num, i, num * i);
        i++;
    }

    // 3. Using 'do-while' loop
    printf("\n--- Multiplication Table using DO-WHILE Loop ---\n");
    i = 1;
    do {
        printf("%d x %d = %d\n", num, i, num * i);
        i++;
    } while (i <= 10);

    return 0;
}
