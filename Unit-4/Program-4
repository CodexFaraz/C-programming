
#include <stdio.h>

int main()
{
    char str[100];
    int i, length = 0;

    printf("Enter a string: ");
    scanf(" %99[^\n]", str);

    while(str[length] != '\0')
    {
        length++;
    }

    printf("Length of string = %d\n", length);

    printf("Reverse string = ");

    for(i = length - 1; i >= 0; i--)
    {
        printf("%c", str[i]);
    }

    return 0;
}
